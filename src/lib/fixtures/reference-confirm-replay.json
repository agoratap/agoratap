{
  "kind": "synthetic-replay",
  "note": "Not a chain receipt and not a payment. Hashes are small integers padded to 32 bytes. This file proves bind to confirmed with no ETH and no RPC.",
  "merchant": "0x1111111111111111111111111111111111111111",
  "other": "0x3333333333333333333333333333333333333333",
  "payer": "0x2222222222222222222222222222222222222222",
  "eurAmount": 1,
  "openHead": 1000,
  "ttlSeconds": 20,
  "referenceFill": 17,
  "frames": [
    {
      "name": "opened-unpaid",
      "head": 1000,
      "finalized": 900,
      "logs": [],
      "expect": { "status": "unpaid", "expired": false, "line": "Waiting" }
    },
    {
      "name": "two-equal-amounts",
      "head": 1006,
      "finalized": 900,
      "logs": [
        { "block": 1001, "tx": 11, "value": "exact", "logIndex": 0 },
        { "block": 1003, "tx": 22, "value": "exact", "logIndex": 0 }
      ],
      "expect": { "status": "ambiguous", "txCount": 2, "line": "Ambiguous" }
    },
    {
      "name": "unknown-hash",
      "head": 1006,
      "finalized": 900,
      "bindTx": 99,
      "logs": [
        { "block": 1001, "tx": 11, "value": "exact", "logIndex": 0 },
        { "block": 1003, "tx": 22, "value": "exact", "logIndex": 0 }
      ],
      "expect": { "status": "unpaid", "claimMissed": true, "expired": false, "line": "does not pay this reference" }
    },
    {
      "name": "claimed-tx-wrong-recipient",
      "head": 1012,
      "finalized": 1001,
      "bindTx": 11,
      "logs": [
        { "block": 1001, "tx": 11, "value": "exact", "logIndex": 0, "to": "other" }
      ],
      "expect": { "status": "unpaid", "claimMissed": true, "line": "does not pay this reference" }
    },
    {
      "name": "claimed-tx-wrong-amount",
      "head": 1012,
      "finalized": 1001,
      "bindTx": 11,
      "logs": [
        { "block": 1001, "tx": 11, "value": "other", "logIndex": 0 }
      ],
      "expect": { "status": "unpaid", "claimMissed": true, "line": "does not pay this reference" }
    },
    {
      "name": "claimed-tx-before-window",
      "head": 1012,
      "finalized": 900,
      "bindTx": 11,
      "logs": [
        { "block": 999, "tx": 11, "value": "exact", "logIndex": 0 }
      ],
      "expect": { "status": "unpaid", "claimMissed": true, "line": "does not pay this reference" }
    },
    {
      "name": "hash-bound-pending",
      "head": 1006,
      "finalized": 900,
      "bindTx": 11,
      "bindCase": "upper",
      "logs": [
        { "block": 1001, "tx": 11, "value": "exact", "logIndex": 0 },
        { "block": 1003, "tx": 22, "value": "exact", "logIndex": 0 }
      ],
      "expect": { "status": "pending", "via": "reference", "confirmations": 6, "line": "Transaction reference matched" }
    },
    {
      "name": "confirmed-not-final",
      "head": 1012,
      "finalized": 1000,
      "bindTx": 11,
      "previous": "hash-bound-pending",
      "logs": [
        { "block": 1001, "tx": 11, "value": "exact", "logIndex": 0 },
        { "block": 1003, "tx": 22, "value": "exact", "logIndex": 0 }
      ],
      "expect": { "status": "confirmed", "via": "reference", "final": false, "confirmations": 12, "line": "not yet final" }
    },
    {
      "name": "confirmed-final",
      "head": 1012,
      "finalized": 1001,
      "bindTx": 11,
      "previous": "confirmed-not-final",
      "logs": [
        { "block": 1001, "tx": 11, "value": "exact", "logIndex": 0 },
        { "block": 1003, "tx": 22, "value": "exact", "logIndex": 0 }
      ],
      "expect": { "status": "confirmed", "via": "reference", "final": true, "confirmations": 12, "line": "does not prove who" }
    },
    {
      "name": "later-equal-amount-stays-on-the-hash",
      "head": 1014,
      "finalized": 1001,
      "bindTx": 11,
      "previous": "confirmed-final",
      "logs": [
        { "block": 1001, "tx": 11, "value": "exact", "logIndex": 0 },
        { "block": 1003, "tx": 22, "value": "exact", "logIndex": 0 },
        { "block": 1008, "tx": 33, "value": "exact", "logIndex": 0 }
      ],
      "expect": { "status": "confirmed", "via": "reference", "final": true, "line": "does not prove who" }
    },
    {
      "name": "extra-different-amount-in-the-same-tx-is-ignored",
      "head": 1012,
      "finalized": 1001,
      "bindTx": 11,
      "logs": [
        { "block": 1001, "tx": 11, "value": "exact", "logIndex": 0 },
        { "block": 1001, "tx": 11, "value": "other", "logIndex": 1 }
      ],
      "expect": { "status": "confirmed", "via": "reference", "final": true, "line": "does not prove who" }
    },
    {
      "name": "two-exact-logs-in-the-claimed-tx-stay-ambiguous",
      "head": 1020,
      "finalized": 1010,
      "bindTx": 11,
      "previous": "confirmed-final",
      "logs": [
        { "block": 1001, "tx": 11, "value": "exact", "logIndex": 0 },
        { "block": 1001, "tx": 11, "value": "exact", "logIndex": 1 }
      ],
      "expect": { "status": "ambiguous", "txCount": 1, "line": "Ambiguous" }
    },
    {
      "name": "bound-transfer-disappears",
      "head": 1013,
      "finalized": 1001,
      "bindTx": 11,
      "previous": "confirmed-final",
      "logs": [],
      "expect": { "status": "reorged", "line": "disappeared" }
    },
    {
      "name": "head-moves-backwards",
      "head": 1011,
      "finalized": 1001,
      "bindTx": 11,
      "previous": "confirmed-final",
      "logs": [
        { "block": 1001, "tx": 11, "value": "exact", "logIndex": 0 }
      ],
      "expect": { "status": "unknown", "line": "No decision yet" }
    },
    {
      "name": "expired-with-a-hash-that-never-lands",
      "head": 1011,
      "finalized": 900,
      "bindTx": 11,
      "logs": [],
      "expect": { "status": "unpaid", "expired": true, "claimMissed": true, "line": "does not pay this reference" }
    }
  ]
}
